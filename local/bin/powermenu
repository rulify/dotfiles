#!/usr/bin/env bash

options="Lock\nSuspend\nReboot\nShutdown\nCancel"

choice=$(printf "$options" | rofi -dmenu -i -p "Power")

case "$choice" in
  Lock)
    loginctl lock-session
    ;;
  Suspend)
    systemctl suspend
    ;;
  Reboot)
    systemctl reboot
    ;;
  Shutdown)
    systemctl poweroff
    ;;
  *)
    exit 0
    ;;
esac
